# Copier ce fichier en .env.local pour le développement local.
# En production (Vercel, Netlify…), ajouter ces variables dans le panneau d'hébergement.

VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=votre_cle_anon_publique

# URL publique du site (OBLIGATOIRE en production — pas localhost)
# Exemple : https://www.lasmoras.com
VITE_SITE_URL=https://www.votre-domaine.com

# Code équipe pour confirmer une réservation via le lien WhatsApp
VITE_CONFIRM_PIN=4006

# ── Supabase Edge Function send-email (secrets côté Supabase, pas ici) ──
# npx supabase secrets set BREVO_API_KEY="..."
# npx supabase secrets set BREVO_SENDER_EMAIL="contactlasmoras@gmail.com"
# npx supabase secrets set BREVO_SENDER_NAME="LAS MORAS"
# npx supabase secrets set SITE_URL="https://www.residencelasmoras.com"
# npx supabase secrets set EMAIL_WEBHOOK_SECRET="secret-aleatoire-long"
# Puis : npx supabase functions deploy send-email
# Et exécuter supabase-brevo-email-triggers.sql dans le SQL Editor
